---
import Layout from '../../layouts/Layout.astro';
import { getAllPosts, getPostBySlug } from '../../lib/blogs';
import { renderMarkdown } from '../../lib/markdown';

export function getStaticPaths() {
  const posts = getAllPosts();
  return posts.map(post => ({
    params: { slug: post.slug }
  }));
}

const { slug } = Astro.params;
const post = getPostBySlug(slug as string);

if (!post) {
  return Astro.redirect('/404');
}

const allPosts = getAllPosts();
const relatedPosts = allPosts.filter(p => p.slug !== post.slug).slice(0, 3);
const htmlContent = renderMarkdown(post.content);

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": post.title,
  "description": post.metaDescription,
  "image": `https://select-and-save.bunnycal.com${post.coverImage}`,
  "author": {
    "@type": "Organization",
    "name": post.author,
    "url": "https://select-and-save.bunnycal.com"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Select & Save",
    "url": "https://select-and-save.bunnycal.com",
    "logo": {
      "@type": "ImageObject",
      "url": "https://select-and-save.bunnycal.com/favicon.svg"
    }
  },
  "datePublished": post.publishedDate,
  "dateModified": post.publishedDate,
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://select-and-save.bunnycal.com/blog/${post.slug}`
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://select-and-save.bunnycal.com" },
    { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://select-and-save.bunnycal.com/blog" },
    { "@type": "ListItem", "position": 3, "name": post.title, "item": `https://select-and-save.bunnycal.com/blog/${post.slug}` }
  ]
};

const blogSchemas = [articleSchema, breadcrumbSchema];
---

<Layout 
  title={post.metaTitle} 
  description={post.metaDescription} 
  type="article"
  publishedDate={post.publishedDate}
  author={post.author}
  keywords={post.keywords}
  jsonLd={blogSchemas}
>
  <article class="py-16 sm:py-24 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto space-y-12">
    
    <!-- Article Header -->
    <header class="space-y-6 text-center sm:text-left border-b border-[#262626] pb-10">
      <div class="flex flex-wrap items-center gap-3 justify-center sm:justify-start">
        <a href="/blog" class="text-xs text-[#0099ff] hover:underline font-mono">← Back to Blog</a>
        <span class="text-xs text-[#262626]">•</span>
        <span class="px-3 py-1 rounded-full bg-[#141414] border border-[#262626] text-xs font-mono text-[#999999]">
          {post.category}
        </span>
        <span class="text-xs text-[#262626]">•</span>
        <span class="text-xs text-[#999999] font-mono">{post.readTime}</span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-display font-bold text-white tracking-tight leading-tight">
        {post.title}
      </h1>

      <div class="flex items-center justify-between pt-4 text-xs text-[#999999] font-mono border-t border-[#1a1a1a]">
        <div class="flex items-center gap-3">
          <img src="/favicon.svg" alt="Select & Save Logo" class="w-8 h-8 object-contain" />
          <div>
            <div class="text-white font-bold">{post.author}</div>
            <div>Published on {post.publishedDate}</div>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <span>Share:</span>
          <a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.title)}&url=${encodeURIComponent(`https://select-and-save.bunnycal.com/blog/${post.slug}`)}`} 
             target="_blank" 
             rel="noopener noreferrer"
             class="px-2.5 py-1 rounded bg-[#141414] border border-[#262626] hover:text-white hover:border-[#0099ff] transition-all">
            Twitter / X
          </a>
        </div>
      </div>
    </header>

    <!-- Article Content -->
    <div class="prose prose-invert max-w-none text-gray-300 font-sans leading-relaxed" set:html={htmlContent} />

    <!-- Keyword Chips -->
    <div class="pt-8 border-t border-[#262626] space-y-3">
      <h4 class="text-xs font-mono uppercase text-[#999999]">Article Topics & Keywords</h4>
      <div class="flex flex-wrap gap-2 text-xs text-[#999999]">
        {post.keywords.map(kw => (
          <span class="px-2.5 py-1 rounded bg-[#141414] border border-[#262626]">
            #{kw}
          </span>
        ))}
      </div>
    </div>

    <!-- Related Articles -->
    <div class="pt-12 border-t border-[#262626] space-y-8">
      <h3 class="text-2xl font-display font-bold text-white tracking-tight">
        Related Research & Guides
      </h3>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {relatedPosts.map(rel => (
          <a href={`/blog/${rel.slug}`} class="p-5 rounded-xl bg-[#141414] border border-[#262626] hover:border-[#0099ff]/50 transition-all group space-y-3">
            <span class="text-[10px] font-mono text-[#0099ff] uppercase">{rel.category}</span>
            <h4 class="font-display font-bold text-white text-base leading-snug group-hover:text-[#0099ff] transition-colors line-clamp-2">
              {rel.title}
            </h4>
            <span class="text-xs text-[#999999] block font-mono">{rel.readTime} →</span>
          </a>
        ))}
      </div>
    </div>

  </article>
</Layout>
