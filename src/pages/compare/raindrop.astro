---
import Layout from '../../layouts/Layout.astro';
import ComparisonTable from '../../components/ComparisonTable.astro';
import { getFaqPageSchema } from '../../lib/faqs';

const seoTitle = "Select & Save vs Raindrop.io — Modern Web Snippet Saver Alternative";
const seoDesc = "Raindrop.io saves full-page links into cloud graveyards. Select & Save captures exact text quotes, code blocks, visual PNG screenshots, and local Chrome AI Q&A cards.";

const faqSchema = getFaqPageSchema([
  {
    q: "Why is Select & Save better than Raindrop.io for saving web research?",
    a: "Raindrop.io saves whole page URLs, forcing you to re-read articles later. Select & Save clips exact text selections, code logic, and automatically generates visual PNG screenshots with local AI Q&A recall."
  },
  {
    q: "Does Select & Save require a monthly subscription like Raindrop.io Pro?",
    a: "No! Select & Save is 100% free with unlimited local storage, full-text search, and local Gemini Nano AI search."
  }
]);

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://select-and-save.bunnycal.com" },
    { "@type": "ListItem", "position": 2, "name": "Comparisons", "item": "https://select-and-save.bunnycal.com/compare" },
    { "@type": "ListItem", "position": 3, "name": "Select & Save vs Raindrop.io", "item": "https://select-and-save.bunnycal.com/compare/raindrop" }
  ]
};

const raindropSchemas = [faqSchema, breadcrumbSchema];
---

<Layout title={seoTitle} description={seoDesc} jsonLd={raindropSchemas}>
  <div class="py-16 sm:py-24 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto space-y-12">
    
    <div class="space-y-4 text-center sm:text-left">
      <div class="flex items-center gap-2 justify-center sm:justify-start">
        <a href="/compare" class="text-xs text-[#0099ff] hover:underline font-mono">← All Comparisons</a>
        <span class="text-xs text-[#262626]">•</span>
        <span class="text-xs text-emerald-400 font-mono">Competitor Teardown</span>
      </div>
      <h1 class="text-4xl sm:text-6xl font-display font-bold text-white tracking-tight leading-tight">
        Select & Save vs Raindrop.io
      </h1>
      <p class="text-base sm:text-lg text-[#999999]">
        Why researchers, developers, and students are switching from Raindrop.io's full-page links to Select & Save's precise text & code snippet clipping.
      </p>
    </div>

    <!-- Core Differentiator Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="p-6 rounded-2xl bg-[#141414] border border-[#262626] space-y-3">
        <div class="text-xs font-mono text-rose-400 font-bold uppercase">The Raindrop.io Limitation</div>
        <h3 class="text-lg font-bold text-white">Full-Page Link Bloat & Cloud Paywalls</h3>
        <p class="text-xs text-[#999999] leading-relaxed">
          Raindrop saves whole URLs. When you re-open a bookmark months later, you must search through a 20-page article to find the single code block or quote you actually needed. Full-text search and visual backups require a paid monthly subscription.
        </p>
      </div>

      <div class="p-6 rounded-2xl bg-[#141414] border border-[#0099ff]/50 space-y-3 bg-gradient-to-br from-[#0099ff]/10 to-[#141414]">
        <div class="text-xs font-mono text-[#0099ff] font-bold uppercase">The Select & Save Solution</div>
        <h3 class="text-lg font-bold text-white">Precise Snippets + Local Chrome AI</h3>
        <p class="text-xs text-gray-300 leading-relaxed">
          Select & Save clips the exact portion of text or code you select, converts it into structured Q&A cards with auto-cropped PNG screenshots, and uses on-device Gemini Nano AI to query your library 100% offline for free.
        </p>
      </div>
    </div>

    <!-- Key Advantages List -->
    <section class="space-y-6">
      <h2 class="text-2xl font-display font-bold text-white border-b border-[#262626] pb-3">
        Key Advantages over Raindrop.io
      </h2>

      <div class="space-y-4 text-sm text-[#999999] leading-relaxed">
        <div class="p-5 rounded-xl bg-[#141414] border border-[#262626] space-y-2">
          <h3 class="text-white font-bold text-base flex items-center gap-2">
            <span class="text-[#0099ff]">1.</span> Bookmark Snippets, Not Full Pages
          </h3>
          <p>
            Instead of cluttering your collection with whole webpage links, save 2-line code logic, definition tables, or quotes.
          </p>
        </div>

        <div class="p-5 rounded-xl bg-[#141414] border border-[#262626] space-y-2">
          <h3 class="text-white font-bold text-base flex items-center gap-2">
            <span class="text-[#6a4cf5]">2.</span> Q&A Flashcard Generator
          </h3>
          <p>
            Automatically convert selected text into Question & Answer cards. Perfect for technical interview prep and study recall.
          </p>
        </div>

        <div class="p-5 rounded-xl bg-[#141414] border border-[#262626] space-y-2">
          <h3 class="text-white font-bold text-base flex items-center gap-2">
            <span class="text-emerald-400">3.</span> Deep-Link Text Fragment Scrolling
          </h3>
          <p>
            When opening the original source URL, Select & Save automatically scrolls to and re-highlights your exact saved quote on the live page using URL text fragments.
          </p>
        </div>
      </div>
    </section>

    <!-- Comparison Table Embed -->
    <section class="space-y-6 pt-4">
      <h2 class="text-2xl font-display font-bold text-white">
        Feature Breakdown: Select & Save vs Raindrop.io
      </h2>
      <ComparisonTable />
    </section>

    <!-- CTA -->
    <div class="p-8 rounded-2xl bg-[#141414] border border-[#262626] text-center space-y-4">
      <h3 class="text-2xl font-display font-bold text-white">Ready for a Better Web Snippet Saver?</h3>
      <p class="text-sm text-[#999999]">Install Select & Save on Chrome today — 100% free with local browser privacy.</p>
      <a href="https://chromewebstore.google.com/detail/select-and-save/fdahohfefbhomeejeekneopnafdmcdai" target="_blank" class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-white text-black font-bold text-sm hover:bg-gray-100 transition-all">
        Add to Chrome — Free
      </a>
    </div>

  </div>
</Layout>
