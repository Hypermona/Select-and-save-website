---
import Layout from '../../layouts/Layout.astro';
import ComparisonTable from '../../components/ComparisonTable.astro';

const seoTitle = "Select & Save vs Raindrop, Omnivore, Anybox & Webbites | Comparison Hub";
const seoDesc = "Compare Select & Save against Raindrop.io, Omnivore, Anybox, and Webbites. See why users choose local-first web snippet clipping, Q&A cards, and on-device Chrome AI.";

const competitors = [
  {
    name: "Raindrop.io",
    slug: "raindrop",
    tagline: "Full-page cloud bookmarking vs snippet-level Q&A clipping",
    badge: "VS RAINDROP",
    diff: "Raindrop saves full URLs, creating massive link bloat. Select & Save captures exact text quotes, code blocks, and visual PNG screenshots directly as local Q&A cards.",
    icon: "💧",
    color: "from-[#0099ff]/20 to-[#141414] border-[#0099ff]/40"
  },
  {
    name: "Omnivore.app",
    slug: "omnivore",
    tagline: "Cloud app shutdown risk vs 100% local-first durability",
    badge: "VS OMNIVORE",
    diff: "Omnivore's cloud platform shutdown left users scrambling to export data. Select & Save stores 100% of your snippets locally in Chrome storage forever.",
    icon: "📖",
    color: "from-[#6a4cf5]/20 to-[#141414] border-[#6a4cf5]/40"
  },
  {
    name: "Anybox.app",
    slug: "anybox",
    tagline: "Mac-only native app lock-in vs universal browser extension",
    badge: "VS ANYBOX",
    diff: "Anybox requires a Mac desktop application. Select & Save is a lightweight cross-platform browser extension running anywhere Chrome, Edge, or Brave runs.",
    icon: "📦",
    color: "from-[#ff7a3d]/20 to-[#141414] border-[#ff7a3d]/40"
  },
  {
    name: "Webbites.io",
    slug: "webbites",
    tagline: "Basic bookmark saver vs Chrome Built-in AI & instant search",
    badge: "VS WEBBITES",
    diff: "Webbites offers basic snippet saving but lacks on-device Gemini Nano AI, deep-link text fragment jump, and instant multi-search overlay (Google, ChatGPT, Claude).",
    icon: "🦈",
    color: "from-[#d44df0]/20 to-[#141414] border-[#d44df0]/40"
  }
];
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://select-and-save.bunnycal.com"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Comparisons",
      "item": "https://select-and-save.bunnycal.com/compare"
    }
  ]
};

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": seoTitle,
  "description": seoDesc,
  "url": "https://select-and-save.bunnycal.com/compare"
};

const compareSchemas = [breadcrumbSchema, pageSchema];
---

<Layout title={seoTitle} description={seoDesc} jsonLd={compareSchemas}>
  <div class="py-16 sm:py-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto space-y-16">
    
    <!-- Compare Hub Header -->
    <div class="text-center space-y-4 max-w-3xl mx-auto">
      <span class="text-xs font-mono uppercase text-[#0099ff] tracking-widest px-3 py-1 rounded-full bg-[#0099ff]/10 border border-[#0099ff]/20">
        Competitor Analysis
      </span>
      <h1 class="text-4xl sm:text-6xl font-display font-bold text-white tracking-tight leading-tight">
        Why Switch to Select & Save?
      </h1>
      <p class="text-base sm:text-lg text-[#999999]">
        Explore detailed side-by-side feature comparisons between Select & Save and alternative web clippers and bookmark tools.
      </p>
    </div>

    <!-- Competitor Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {competitors.map(c => (
        <div class={`p-8 rounded-3xl bg-gradient-to-br border ${c.color} space-y-6 flex flex-col justify-between group hover:-translate-y-1 transition-all duration-300`}>
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="text-4xl">{c.icon}</span>
              <span class="text-xs font-mono font-bold px-3 py-1 rounded-full bg-[#090909] text-white border border-[#262626]">
                {c.badge}
              </span>
            </div>

            <h2 class="text-2xl sm:text-3xl font-display font-bold text-white tracking-tight group-hover:text-[#0099ff] transition-colors">
              Select & Save vs {c.name}
            </h2>

            <p class="text-xs font-mono text-[#0099ff]">{c.tagline}</p>

            <p class="text-sm text-[#999999] leading-relaxed">
              {c.diff}
            </p>
          </div>

          <div class="pt-4 border-t border-[#262626]">
            <a href={`/compare/${c.slug}`} class="inline-flex items-center justify-between w-full px-5 py-3 rounded-xl bg-[#090909] text-white font-semibold text-xs sm:text-sm hover:bg-white hover:text-black transition-all">
              <span>Read Deep-Dive Teardown</span>
              <span>→</span>
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- Full Feature Matrix Table -->
    <div class="space-y-8 pt-8 border-t border-[#262626]">
      <div class="text-center space-y-2">
        <h2 class="text-2xl sm:text-4xl font-display font-bold text-white tracking-tight">
          Complete Side-by-Side Feature Matrix
        </h2>
        <p class="text-sm text-[#999999]">
          Evaluating snippet clipping, AI query capabilities, privacy guarantees, and layout features.
        </p>
      </div>

      <ComparisonTable />
    </div>

  </div>
</Layout>
