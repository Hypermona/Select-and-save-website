---
import Layout from '../../layouts/Layout.astro';
import ComparisonTable from '../../components/ComparisonTable.astro';
import { getFaqPageSchema } from '../../lib/faqs';

const seoTitle = "Select & Save vs Anybox — Cross-Platform Web Snippet Saver";
const seoDesc = "Anybox locks users into the Apple Mac/iOS ecosystem. Select & Save is a lightweight cross-platform browser extension running anywhere Chrome, Edge, or Brave runs.";

const faqSchema = getFaqPageSchema([
  {
    q: "How does Select & Save compare to Anybox for non-Mac users?",
    a: "Anybox requires a Mac OS desktop installation. Select & Save works on Windows, Linux, Mac, and Chromebooks directly inside Chromium browsers."
  },
  {
    q: "Does Select & Save capture screenshots like Anybox?",
    a: "Yes! Select & Save automatically generates high-resolution visual PNG screenshots of your selected web text or code snippet."
  }
]);

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://select-and-save.bunnycal.com" },
    { "@type": "ListItem", "position": 2, "name": "Comparisons", "item": "https://select-and-save.bunnycal.com/compare" },
    { "@type": "ListItem", "position": 3, "name": "Select & Save vs Anybox", "item": "https://select-and-save.bunnycal.com/compare/anybox" }
  ]
};

const anyboxSchemas = [faqSchema, breadcrumbSchema];
---

<Layout title={seoTitle} description={seoDesc} jsonLd={anyboxSchemas}>
  <div class="py-16 sm:py-24 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto space-y-12">
    
    <div class="space-y-4 text-center sm:text-left">
      <div class="flex items-center gap-2 justify-center sm:justify-start">
        <a href="/compare" class="text-xs text-[#0099ff] hover:underline font-mono">← All Comparisons</a>
        <span class="text-xs text-[#262626]">•</span>
        <span class="text-xs text-[#fb923c] font-mono">Competitor Teardown</span>
      </div>
      <h1 class="text-4xl sm:text-6xl font-display font-bold text-white tracking-tight leading-tight">
        Select & Save vs Anybox
      </h1>
      <p class="text-base sm:text-lg text-gray-300">
        Break free from Mac-only OS lock-in with a universal Chromium web extension.
      </p>
    </div>

    <!-- Core Differentiator Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="p-6 rounded-2xl bg-[#141414] border border-[#262626] space-y-3">
        <div class="text-xs font-mono text-amber-300 font-bold uppercase">The Ecosystem Barrier</div>
        <h2 class="text-lg font-bold text-white">Anybox Apple Mac Lock-In</h2>
        <p class="text-xs text-gray-300 leading-relaxed">
          Anybox requires installing a native Mac OS desktop application. If you switch between Windows, Linux, Chromebooks, or work PCs, you lose seamless browser clipping capabilities.
        </p>
      </div>

      <div class="p-6 rounded-2xl bg-[#141414] border border-[#ff7a3d]/50 space-y-3 bg-gradient-to-br from-[#ff7a3d]/10 to-[#141414]">
        <div class="text-xs font-mono text-[#fb923c] font-bold uppercase">The Select & Save Advantage</div>
        <h2 class="text-lg font-bold text-white">Universal Browser Extension</h2>
        <p class="text-xs text-gray-300 leading-relaxed">
          Select & Save runs directly inside Chrome, Edge, Brave, Opera, Arc, and all Chromium browsers on Windows, macOS, Linux, and ChromeOS with 100% feature parity.
        </p>
      </div>
    </div>

    <!-- Feature Table Embed -->
    <section class="space-y-6 pt-4">
      <h2 class="text-2xl font-display font-bold text-white">
        Feature Breakdown: Select & Save vs Anybox
      </h2>
      <ComparisonTable />
    </section>

    <!-- CTA -->
    <div class="p-8 rounded-2xl bg-[#141414] border border-[#262626] text-center space-y-4">
      <h3 class="text-2xl font-display font-bold text-white">Ready for a Cross-Platform Web Saver?</h3>
      <p class="text-sm text-gray-300">Install Select & Save on Chrome today — 100% free with local browser privacy.</p>
      <a href="https://chromewebstore.google.com/detail/select-and-save/fdahohfefbhomeejeekneopnafdmcdai" target="_blank" class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-white text-black font-bold text-sm hover:bg-gray-100 transition-all">
        Add to Chrome — Free
      </a>
    </div>

  </div>
</Layout>
