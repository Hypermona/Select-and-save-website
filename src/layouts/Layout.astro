---
import SEO from '../components/SEO.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  type?: 'website' | 'article';
  publishedDate?: string;
  author?: string;
  keywords?: string[];
  jsonLd?: object;
  hideHeaderFooter?: boolean;
}

const { hideHeaderFooter = false, ...seoProps } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-KLXTYGB6B9"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-KLXTYGB6B9');
    </script>

    <SEO {...seoProps} />
    
    <!-- Preconnect to Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet">
  </head>
  <body class="bg-[#08090d] text-white min-h-screen flex flex-col font-sans selection:bg-[#00d2ff]/30 selection:text-white antialiased">
    
    {!hideHeaderFooter && <Navbar />}

    <main class="flex-grow z-10">
      <slot />
    </main>

    {!hideHeaderFooter && <Footer />}
  </body>
</html>
