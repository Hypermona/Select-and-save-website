---
import SEO from '../components/SEO.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  type?: 'website' | 'article';
  publishedDate?: string;
  author?: string;
  keywords?: string[];
  jsonLd?: object;
  hideHeaderFooter?: boolean;
}

const { hideHeaderFooter = false, ...seoProps } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <SEO {...seoProps} />

    <!-- Google tag (gtag.js) - loaded on interaction/deferred -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-KLXTYGB6B9');

      function initGtag() {
        if (window.__gtagLoaded) return;
        window.__gtagLoaded = true;
        ['scroll', 'mousemove', 'touchstart', 'click', 'keydown'].forEach(e => {
          window.removeEventListener(e, initGtag, { passive: true });
        });
        const s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=G-KLXTYGB6B9';
        document.head.appendChild(s);
      }
      ['scroll', 'mousemove', 'touchstart', 'click', 'keydown'].forEach(e => {
        window.addEventListener(e, initGtag, { passive: true, once: true });
      });
      setTimeout(initGtag, 4000);
    </script>
  </head>
  <body class="bg-[#08090d] text-white min-h-screen flex flex-col font-sans selection:bg-[#00d2ff]/30 selection:text-white antialiased">
    
    {!hideHeaderFooter && <Navbar />}

    <main class="flex-grow z-10">
      <slot />
    </main>

    {!hideHeaderFooter && <Footer />}
  </body>
</html>
