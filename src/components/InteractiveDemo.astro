        </svg>
        <span>Claude</span>
      </button>
    </div>

    <!-- Live Result Toast / Card -->
    <div id="demo-result-toast" class="hidden mt-6 p-4 rounded-xl bg-gradient-to-r from-[#141414] to-[#1c1c1c] border border-emerald-500/40 shadow-xl space-y-2 animate-slide-up">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2 text-xs font-bold text-emerald-400">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
          <span id="toast-title">Snippet Saved to Q&A Library!</span>
        </div>
        <span class="text-[10px] text-[#999999] font-mono">100% On-Device Storage</span>
      </div>
      <div id="toast-body" class="text-xs text-gray-200 font-mono p-2.5 rounded bg-[#090909] border border-[#262626]">
        Q: What is personal knowledge capture logic? <br/>
        A: "building a second brain shouldn't require saving whole articles when all you need is a 2-line code logic block..."
      </div>
    </div>

  </div>
</div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const article = document.getElementById('demo-article');
    const actionBar = document.getElementById('floating-action-bar');
    const toast = document.getElementById('demo-result-toast');
    const toastTitle = document.getElementById('toast-title');
    const toastBody = document.getElementById('toast-body');

    const sample1 = document.getElementById('sample-quote-1');
    const sample2 = document.getElementById('sample-quote-2');

    const btnSave = document.getElementById('btn-act-save');
    const btnGoogle = document.getElementById('btn-act-google');
    const btnChatGPT = document.getElementById('btn-act-chatgpt');
    const btnClaude = document.getElementById('btn-act-claude');

    let currentSelectedText = "";

    function showActionBarAt(x, y, text) {
      currentSelectedText = text;
      if (actionBar) {
        actionBar.style.left = `${Math.min(x, 450)}px`;
        actionBar.style.top = `${Math.max(y - 50, 10)}px`;
        actionBar.classList.remove('hidden');
      }
    }

    // Handle user manual selection
    article?.addEventListener('mouseup', () => {
      const selection = window.getSelection();
      const text = selection ? selection.toString().trim() : '';
      if (text.length > 5) {
        showActionBarAt(120, 140, text);
      }
    });

    // Sample preset triggers
    sample1?.addEventListener('click', () => {
      const snippet = "const saveSnippet = async (selectedText, sourceUrl) => { ... }";
      showActionBarAt(140, 160, snippet);
    });

    sample2?.addEventListener('click', () => {
      const snippet = "a 2-line code logic block or specific question & answer pair";
      showActionBarAt(100, 110, snippet);
    });

    // Action handlers
    btnSave?.addEventListener('click', () => {
      actionBar?.classList.add('hidden');
      toastTitle.textContent = "✅ Q&A Knowledge Card Created!";
      toastBody.innerHTML = `<strong>Q:</strong> Saved Snippet<br/><span class="text-emerald-300">"${currentSelectedText || 'a 2-line code logic block or specific question & answer pair'}"</span><br/><span class="text-[10px] text-gray-400">Captured with PNG Crop + Deep Link Target</span>`;
      toast?.classList.remove('hidden');
    });

    btnGoogle?.addEventListener('click', () => {
      actionBar?.classList.add('hidden');
      toastTitle.textContent = "🔍 Instant Google Search Launched!";
      toastBody.textContent = `Querying Google for: "${currentSelectedText || 'React state memory'}"`;
      toast?.classList.remove('hidden');
    });

    btnChatGPT?.addEventListener('click', () => {
      actionBar?.classList.add('hidden');
      toastTitle.textContent = "🤖 ChatGPT Instant Prompt Sent!";
      toastBody.textContent = `Prompt: "Explain this snippet in detail: '${currentSelectedText || 'React state memory'}'"`;
      toast?.classList.remove('hidden');
    });

    btnClaude?.addEventListener('click', () => {
      actionBar?.classList.add('hidden');
      toastTitle.textContent = "🧠 Claude AI Deep Analysis Triggered!";
      toastBody.textContent = `Analyzing text context with Claude: "${currentSelectedText || 'React state memory'}"`;
      toast?.classList.remove('hidden');
    });
  });
</script>
