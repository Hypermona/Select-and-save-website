        </svg>
        <span>Claude</span>
      </span>
    </div>
  </div>

  <!-- TILE 6: Wide Tile (Mosaic Masonry & List Views) -->
  <div class="md:col-span-2 lg:col-span-2 rounded-3xl p-8 relative overflow-hidden group flex flex-col justify-between border border-[#8b5cf6]/40 bg-gradient-to-br from-[#6366f1]/20 via-[#0e1017] to-[#8b5cf6]/20 backdrop-blur-xl shadow-xl hover:border-[#8b5cf6] hover:shadow-[#8b5cf6]/20 transition-all duration-300">
    <div class="space-y-4 relative z-10">
      <div class="flex items-center justify-between">
        <span class="px-3.5 py-1 rounded-full text-xs font-mono font-bold uppercase bg-[#6366f1]/20 text-[#a5b4fc] border border-[#6366f1]/40">
          CUSTOMIZABLE CANVAS
        </span>
        <span class="text-3xl">🎨</span>
      </div>

      <h3 class="text-2xl font-display font-bold text-white tracking-tight">
        Mosaic Masonry & Compact List Views
      </h3>

      <p class="text-sm text-gray-300 leading-relaxed">
        Visual layout tailored for screenshots, code syntax highlighting, auto-domain folders, and color-coded tag organization.
      </p>
    </div>

    <div class="mt-6 flex items-center justify-between p-3.5 rounded-2xl bg-[#08090d] border border-[#8b5cf6]/30 text-xs text-gray-300">
      <div class="flex items-center gap-3">
        <span class="px-3.5 py-1.5 rounded-xl bg-gradient-to-r from-[#00d2ff] to-[#8b5cf6] text-white font-bold shadow-md">Mosaic Grid</span>
        <span class="px-3.5 py-1.5 rounded-xl bg-[#161926] text-gray-300 border border-white/10">Compact List</span>
      </div>
      <span class="font-mono text-[#c084fc] font-bold">Auto-Domain Grouping</span>
    </div>
  </div>

</div>
