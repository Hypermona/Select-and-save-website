---
export interface Props {
  title: string;
  description: string;
  badge?: string;
  variant?: 'violet' | 'magenta' | 'orange' | 'coral' | 'blue';
  icon?: string;
  className?: string;
}

const {
  title,
  description,
  badge,
  variant = 'violet',
  icon,
  className = ''
} = Astro.props;

const variantStyles = {
  violet: 'from-[#6a4cf5]/20 via-[#141414] to-[#141414] border-[#6a4cf5]/40 hover:border-[#6a4cf5] glow-violet',
  magenta: 'from-[#d44df0]/20 via-[#141414] to-[#141414] border-[#d44df0]/40 hover:border-[#d44df0] glow-magenta',
  orange: 'from-[#ff7a3d]/20 via-[#141414] to-[#141414] border-[#ff7a3d]/40 hover:border-[#ff7a3d] glow-orange',
  coral: 'from-[#ff5577]/20 via-[#141414] to-[#141414] border-[#ff5577]/40 hover:border-[#ff5577] glow-magenta',
  blue: 'from-[#0099ff]/20 via-[#141414] to-[#141414] border-[#0099ff]/40 hover:border-[#0099ff] glow-blue'
};

const badgeStyles = {
  violet: 'bg-[#6a4cf5]/20 text-[#6a4cf5] border-[#6a4cf5]/30',
  magenta: 'bg-[#d44df0]/20 text-[#d44df0] border-[#d44df0]/30',
  orange: 'bg-[#ff7a3d]/20 text-[#ff7a3d] border-[#ff7a3d]/30',
  coral: 'bg-[#ff5577]/20 text-[#ff5577] border-[#ff5577]/30',
  blue: 'bg-[#0099ff]/20 text-[#0099ff] border-[#0099ff]/30'
};
---

<div class={`relative p-6 sm:p-8 rounded-3xl bg-gradient-to-b border transition-all duration-300 group overflow-hidden flex flex-col justify-between ${variantStyles[variant]} ${className}`}>
  <!-- Decorative Glow Circle -->
  <div class="absolute -top-12 -right-12 w-44 h-44 rounded-full bg-white/5 blur-2xl group-hover:scale-150 transition-transform duration-500 pointer-events-none"></div>

  <div class="space-y-4 relative z-10">
    <div class="flex items-center justify-between">
      {badge && (
        <span class={`px-3 py-1 rounded-full text-xs font-mono font-semibold border ${badgeStyles[variant]}`}>
          {badge}
        </span>
      )}
      {icon && <span class="text-2xl">{icon}</span>}
    </div>

    <h3 class="text-2xl sm:text-3xl font-display font-bold text-white tracking-tight leading-tight group-hover:translate-x-1 transition-transform">
      {title}
    </h3>

    <p class="text-sm sm:text-base text-[#999999] leading-relaxed">
      {description}
    </p>
  </div>

  <div class="pt-6 relative z-10">
    <slot />
  </div>
</div>
